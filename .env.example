# Every variable the app reads, with dummy values. Real values live in the
# Vercel dashboard (Settings → Environment Variables); for `vercel dev`, copy
# this file to `.env.local`.

# --- Set by the Supabase integration from the Vercel Marketplace ------------
# The app accepts the integration's own names (SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, ...) as well as the
# VITE_ ones below, so nothing needs renaming after installing it.
VITE_SUPABASE_URL=https://example-project.supabase.co
# Public by design: it can only listen to the Realtime channel.
VITE_SUPABASE_ANON_KEY=dummy-anon-key
# Server only. Never prefix with VITE_ or NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key

# --- Set by you ---------------------------------------------------------------
# Any long random string, e.g. `openssl rand -base64 32`. Signs the guests'
# and the admin's cookies; changing it logs everyone out.
SESSION_SECRET=dummy-session-secret-change-me
# Password for /admin.
ADMIN_PASSWORD=dummy-admin-password
# The answers. One word each. Shown to nobody before "Paljasta nimi".
CORRECT_SECOND_NAME=Esimerkki
CORRECT_FIRST_NAME=Testi
